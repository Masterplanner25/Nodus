// agent_typed.nd
// Schema-forced agent calls + ordered concurrent fan-out for Nodus.
//
// STATUS (re-verified 2026-09-17 against 5.13.0): every path here overlaps.
// `agent.call_async` has existed since 4.1.0 (#294), so a fan_out() over
// invoke() below runs its agent calls concurrently -- measured by
// run_judge_panel.py: 10 x 200 ms of stub agents in ~600 ms. The stdlib async
// wrappers (http.*_async, subprocess.run_async) have overlapped since 4.0.8
// (#105 / #290). Earlier revisions of this file said agent calls were
// serial; that was true when written and is not now.
import "std:agent" as agent
import "std:json" as json

// ─────────────────────────────────────────────────────────────────────────
// The single agent-execution seam. This is the ONLY place to change the
// transport; typed() and the judge panel are agnostic to it.
//
// `agent.call_async` suspends the calling coroutine while the host handler
// runs on its own thread, which is what lets fan_out() overlap. Swap the body
// for `http.post_async(AGENT_HOST + "/run", {...})` to reach a remote model
// host instead; the orchestration above it does not change.
//
// Either way the value that comes back is the nine-key envelope documented in
// docs/guide/agent-host-boundary.md §3 -- the handler's return is under
// `result`, and `ok: false` is a soft failure, not an exception.
// ─────────────────────────────────────────────────────────────────────────
export fn invoke(name, payload) {
    return agent.call_async(name, payload)
}

// Unwrap the agent envelope to the handler's value, then coerce to a map.
// Handlers may return a JSON string or an already-structured map; normalize
// so callers can validate keys uniformly. A failed call (`ok: false`) yields
// an empty map, so the required-key check below reports every key missing
// and typed() retries -- an unregistered agent therefore fails cleanly after
// max_attempts rather than crashing the fan-out.
fn _as_map(envelope) {
    if (envelope["ok"] == false) {
        return {}
    }
    let value = envelope["result"]
    if (type(value) == "string") {
        return json.parse(value)
    }
    if (value == nil) {
        return {}
    }
    return value
}

// Return the list of required keys missing from a result map.
fn _missing_keys(result, required) {
    let missing = []
    let i = 0
    while (i < len(required)) {
        if (map_has_key(result, required[i]) == false) {
            list_push(missing, required[i])
        }
        i = i + 1
    }
    return missing
}

// On a retry, tell the agent which required keys it omitted last time.
fn _augment(payload, missing) {
    if (missing == nil) {
        return payload
    }
    payload["__missing_required"] = missing
    return payload
}

// ─────────────────────────────────────────────────────────────────────────
// typed(): invoke an agent and force its output to satisfy a required-key
// "schema". Re-invokes (up to max_attempts) when keys are missing, feeding the
// missing list back to the agent. This is the pragmatic stand-in for the JS
// workflow tool's `schema:` option; extend _missing_keys for value/type checks.
// Returns the validated map, or an error map if it never validates.
// ─────────────────────────────────────────────────────────────────────────
export fn typed(name, payload, required_keys, max_attempts) {
    let attempts = max_attempts
    if (attempts == nil) {
        attempts = 3
    }
    let last_missing = nil
    let last_failure = nil
    let i = 0
    while (i < attempts) {
        let envelope = invoke(name, _augment(payload, last_missing))
        if (envelope["ok"] == false) {
            last_failure = envelope["errors"][0]["message"]
        }
        let result = _as_map(envelope)
        let missing = _missing_keys(result, required_keys)
        if (len(missing) == 0) {
            return result
        }
        last_missing = missing
        i = i + 1
    }
    // `failure` is the agent's own last error when the call itself failed
    // (e.g. "No handler registered for agent 'solver'"), nil when the agent
    // answered but left keys out.
    return {"ok": false, "error": "schema_validation_failed", "agent": name, "missing": last_missing, "failure": last_failure}
}

// ─────────────────────────────────────────────────────────────────────────
// fan_out(): run worker(item) for every item concurrently, preserving input
// order in the returned list.
//
// One coroutine per item, driven by a single run_loop(). Whether they overlap
// is decided entirely by what worker() does inside: a call that suspends
// (agent.call_async, http.get_async, sleep) overlaps; synchronous work runs
// to completion one coroutine at a time. Results are collected in a map keyed
// by index, then rebuilt in order.
//
// run_loop() returns the list of errors raised inside coroutines rather than
// raising them, so a worker that throws would otherwise vanish and surface
// later as a missing index. Re-raise here, naming the first one.
// ─────────────────────────────────────────────────────────────────────────
export fn fan_out(items, worker) {
    let n = len(items)
    let bucket = {}
    let i = 0
    while (i < n) {
        let idx = i
        let item = items[i]
        spawn(coroutine(fn() { bucket[str(idx)] = worker(item) }))
        i = i + 1
    }
    let errors = run_loop()
    if (errors != nil) {
        throw "fan_out: " + str(len(errors)) + " worker(s) failed; first: " + errors[0]
    }
    let results = []
    let k = 0
    while (k < n) {
        list_push(results, bucket[str(k)])
        k = k + 1
    }
    return results
}
