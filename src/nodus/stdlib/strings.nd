fn upper(s) {
    return str_upper(s)
}

fn lower(s) {
    return str_lower(s)
}

fn trim(s) {
    return str_trim(s)
}

fn split(s, delimiter) {
    return str_split(s, delimiter)
}

fn contains(s, substring) {
    return str_contains(s, substring)
}

fn starts_with(s, prefix) {
    return str_startswith(s, prefix)
}

fn ends_with(s, suffix) {
    return str_endswith(s, suffix)
}

fn repeat(s, n) {
    let out = ""
    let i = 0
    while (i < n) {
        out = out + s
        i = i + 1
    }
    return out
}

fn is_blank(s) {
    return len(str_trim(s)) == 0
}

fn replace(s, old, new) {
    return str_replace(s, old, new)
}

// The characters from `start` up to, not including, `end` (the length if
// omitted). Out-of-range bounds are an error, not clamped.
fn substring(s, start, end) {
    return str_substring(s, start, end)
}

// Where the run of characters in `chars`, starting at `start`, ends: an index,
// for `substring`. `span("abc123", 3i, "0123456789")` is 6.
fn span(s, start, chars) {
    return str_span(s, start, chars)
}

// Where the run of characters NOT in `chars` ends: the index of the first
// character from `start` that is in `chars`, or the length.
fn span_until(s, start, chars) {
    return str_span_until(s, start, chars)
}

fn join(items, sep) {
    let out = ""
    let i = 0
    while (i < len(items)) {
        if (i > 0) {
            out = out + sep
        }
        out = out + str(items[i])
        i = i + 1
    }
    return out
}
