fn sleep(ms) {
    return __sleep(ms)
}

fn _spawn_task(task) {
    if (type(task) == "coroutine") {
        spawn(task)
        return task
    }
    return spawn(coroutine(task))
}

// #1021: these drive their own tasks, not the caller's scheduler. They called
// run_loop(), which also ran every coroutine the caller had spawned and not
// yet started. __settle(t) is wait(t) without taking the outcome: a failing
// task is reported as it always was, and the rest still run.
fn parallel(tasks) {
    let started = []
    let i = 0
    while (i < len(tasks)) {
        started = started + [_spawn_task(tasks[i])]
        i = i + 1
    }
    let j = 0
    while (j < len(started)) {
        __settle(started[j])
        j = j + 1
    }
}

fn series(tasks) {
    let i = 0
    while (i < len(tasks)) {
        __settle(_spawn_task(tasks[i]))
        i = i + 1
    }
}

fn graph_run(tasks) {
    return run_graph(graph(tasks))
}

fn queue() {
    return channel()
}

fn worker_pool(worker, count) {
    let jobs = channel()
    let i = 0
    while (i < count) {
        spawn(coroutine(fn() {
            let item = recv(jobs)
            while (item != nil) {
                worker(item)
                item = recv(jobs)
            }
        }))
        i = i + 1
    }
    return jobs
}

fn pipeline(stages) {
    let input = channel()
    let current = input
    let i = 0
    while (i < len(stages)) {
        let stage = stages[i]
        let output = channel()
        let source = current
        spawn(coroutine(fn() {
            let item = recv(source)
            while (item != nil) {
                let result = stage(item)
                send(output, result)
                item = recv(source)
            }
            close(output)
        }))
        current = output
        i = i + 1
    }
    return record {input: input, output: current}
}
