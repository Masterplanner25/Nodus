// AFTER: the same transform, now an observable, governed unit of work.
//
// Run: nodus run --time-limit 10 pipeline.nd
//
// What this adds over bare Python:
//   - Three declared steps with explicit ordering (`after`), so a failure
//     stops the pipeline instead of letting later steps run on stale output
//   - Pre/post condition checks with clear error messages
//   - Structured exit-code handling (no silent failures, no leaked traceback)
//   - A result map naming which step failed and why, and a non-zero exit
import "std:fs" as fs
import "std:strings" as strings
import "std:subprocess" as subprocess

let in_path = "sample_input.json"
let out_path = "output.json"
workflow convert {
    step check_input {
        print("[1/3] checking input...")
        if (!fs.exists(in_path)) {
            throw "input file not found: " + in_path
        }
    }
    step transform after check_input {
        print("[2/3] running transform...")
        // check: false -- a non-zero exit comes back as an ordinary result
        // record (exit_code, stdout, stderr) rather than an error, so the
        // step decides what a failure means.
        let result = subprocess.run(["python", "transform.py", in_path, out_path, "name", "email"], record {check: false})
        if (result.exit_code != 0i) {
            // The last line of stderr is the one a Python traceback ends with.
            let lines = strings.split(strings.trim(result.stderr), "\n")
            throw "transform exited " + str(result.exit_code) + ": " + lines[len(lines) - 1i]
        }
        print(strings.trim(result.stdout))
    }
    step verify after transform {
        print("[3/3] verifying output...")
        if (!fs.exists(out_path)) {
            throw "output file was not created: " + out_path
        }
    }
}
print("=== pipeline start ===")
let r = run_workflow(convert)
if (len(r["failed"]) > 0i) {
    print("=== pipeline FAILED at step '" + r["failed"][0i] + "': " + r["error"] + " ===")
    throw "pipeline failed at step '" + r["failed"][0i] + "'"
}
print("=== pipeline done ===")
