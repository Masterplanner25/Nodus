// fanout_walltime_test.nd
// A wall-clock regression test: it asserts that fanned-out I/O-bound calls
// actually OVERLAP, measured against a real concurrent server -- not an
// instant in-process mock.
//
// MEASURED (5.13.0, 2026-09-17, 6 x 300 ms requests, this harness, warm):
//   - idiomatic http.get_async wrapper -> ~320 ms : full overlap
//   - raw direct http_get_async        -> ~330 ms : full overlap
// Both paths have overlapped fully since #295 (closed 2026-07-10); the file
// used to record the raw path at ~1068 ms partial overlap and assert only that
// it beat serial. Both cases now assert the same bar.
//
// WARM-UP (#855): the very first HTTP request of a *process* pays ~0.4-1 s to
// load the CA bundle, and in a fan-out the N worker threads all wait on it --
// so a cold first fan-out measured 0.76-1.3 s here for 6 x 300 ms (1.1-1.9 s
// before #855 made the load once-per-process rather than once-per-VM),
// sometimes over the 900 ms bar and sometimes not, for a reason that has
// nothing to do with overlap. One synchronous request before the timed cases
// takes that cost outside the measurement.
//
// SETUP: point BASE at a LOCAL server that delays each response ~PER_REQ_MS and
// serves requests concurrently. Any will do, e.g.:
//   python -c "import time;from http.server import *;//     class H(BaseHTTPRequestHandler)://       def do_GET(s): time.sleep(0.3); s.send_response(200); s.end_headers(); s.wfile.write(b'ok')//     ThreadingHTTPServer(('127.0.0.1',8099),H).serve_forever()"
// Run:  nodus test fanout_walltime_test.nd
import "std:test" as test
import "std:time" as time
import "std:http" as http

let BASE = "http://127.0.0.1:8099/delay"
let N = 6
let PER_REQ_MS = 300
let SERIAL_MS = N * PER_REQ_MS
// 1800ms if fully serial
let OVERLAP_CEILING_MS = N * PER_REQ_MS / 2
// 900ms: must beat this to count as overlapping
// #855: pay the shared client's construction once, before anything is timed.
let _warm = http.get(BASE + "/0")

fn _now_ms() {
    return time.to_epoch_ms(time.now())
}

// IDIOMATIC path: the stdlib wrapper real orchestration code would call.
// This is the path the wrapper->sync bug (#105) used to defeat.
fn _fanout_wrapper(n) {
    let bucket = {}
    let i = 0
    while (i < n) {
        let idx = i
        spawn(coroutine(fn() { bucket[str(idx)] = http.get_async(BASE + "/" + str(PER_REQ_MS)) }))
        i = i + 1
    }
    run_loop()
    return bucket
}

// CONTROL path: the RAW builtin called directly in the coroutine body. Proves
// the server + harness can observe overlap at all, so a RED idiomatic case is a
// real bug, not a flaky setup.
fn _fanout_raw(n) {
    let bucket = {}
    let i = 0
    while (i < n) {
        let idx = i
        spawn(coroutine(fn() { bucket[str(idx)] = http_get_async(BASE + "/" + str(PER_REQ_MS)) }))
        i = i + 1
    }
    run_loop()
    return bucket
}

test.suite("agent fan-out overlaps", fn() {
    test.case("raw direct builtin overlaps", fn() {
        let t0 = _now_ms()
        _fanout_raw(N)
        let elapsed = _now_ms() - t0
        print("raw builtin fan-out: " + str(elapsed) + "ms (serial would be " + str(SERIAL_MS) + "ms)")
        test.assert(elapsed < OVERLAP_CEILING_MS, "raw http_get_async fan-out did not overlap; if the wrapper case is green too, check the test server is concurrent")
    })
    test.case("idiomatic http.get_async wrapper overlaps", fn() {
        let t0 = _now_ms()
        _fanout_wrapper(N)
        let elapsed = _now_ms() - t0
        print("wrapper fan-out: " + str(elapsed) + "ms (serial would be " + str(SERIAL_MS) + "ms)")
        test.assert(elapsed < OVERLAP_CEILING_MS, "http.get_async fan-out went serial -- the wrapper->sync fallback (#105) has regressed")
    })
})
