# Python cache
__pycache__/
*.pyc
*.pyo

# Virtual environments
.venv/
venv/
cleanenv/
# All throwaway validation venvs -- glob, not one entry per venv.
# Release validation creates several (.venv-validation, .venv-postpublish,
# .venv-jup, ...); adding them one at a time meant `git add -A` swept two
# of them into the index during the v4.2.0 release.
.venv-*/
.release-venv/
cleanenv/
.release-smoke/

# Test cache
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# OS files
.DS_Store
Thumbs.db

# Nodus runtime data
.nodus/

# Virtual environment 
.venv/

# Claude Code
.claude/
!.claude/commands/
!.claude/commands/*.md

# Audit reports
AUDIT_REPORT*.md
DOCS_AUDIT_REPORT*.md

# Planning and evaluation documents (working files, not part of the repo)
Session Handoff Summary*.md
docs/governance/V3_0_PLAN.md
CAPTURE RELEASE PLAYBOOK.md
DOCS AUDIT TASK.md
EVAL_LOG.md
P0 BLOCKER FIXES.md
PYPI RELEASE.md
