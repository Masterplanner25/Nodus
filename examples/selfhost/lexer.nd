// lexer.nd -- the Nodus lexer, written in Nodus (#173).
//
// A port of src/nodus/frontend/lexer.py. It produces the same token stream --
// kind, value, line and column -- and tools/selfhost_check.py holds it to that,
// token for token, over every tracked .nd file in the repository.
//
// The Python lexer matches one compiled regular expression per token. Nodus has
// no regex, so `scan_token` reproduces the regex's alternation order by hand:
// it scans by index and cuts each token's text out with `substring`.
//
// A token is a record: {kind, val, line, col}.
let KEYWORDS = {"let": "LET", "print": "PRINT", "if": "IF", "else": "ELSE", "while": "WHILE", "for": "FOR", "true": "TRUE", "false": "FALSE", "fn": "FN", "return": "RETURN", "nil": "NIL", "import": "IMPORT", "as": "AS", "export": "EXPORT", "from": "FROM", "try": "TRY", "catch": "CATCH", "finally": "FINALLY", "throw": "THROW", "record": "RECORD", "in": "IN", "yield": "YIELD", "workflow": "WORKFLOW", "goal": "GOAL", "step": "STEP", "after": "AFTER", "with": "WITH", "action": "ACTION"}
let TWO_CHAR_OPS = {"&&": true, "||": true, "==": true, "!=": true, "<=": true, ">=": true, "->": true, "=>": true, "+=": true, "-=": true, "*=": true, "/=": true}
let ONE_CHAR_OPS = {"+": true, "-": true, "*": true, "/": true, "=": true, "%": true, "(": true, ")": true, "{": true, "}": true, "[": true, "]": true, ",": true, ";": true, ":": true, ".": true, "<": true, ">": true, "!": true, "@": true}
let SIMPLE_ESCAPES = {"n": "\n", "t": "\t", "r": "\r", "0": "\0", "\"": "\"", "\\": "\\"}
let MAX_INTERP_DEPTH = 32i
let DIGITS = "0123456789"
let IDENT_CHARS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789"
// What ends a run of plain text inside a string literal.
let STRING_STOPS = "\"\\\n"

fn fail(msg, line, col) {
    throw "\(line):\(col): \(msg)"
}

fn tok(kind, val, line, col) {
    return record {kind: kind, val: val, line: line, col: col}
}

fn char_at(src, i, n) {
    if (i >= n) {
        return ""
    }
    return src[i]
}

fn is_digit(c) {
    return c >= "0" && c <= "9" && c != ""
}

fn is_ident_start(c) {
    return c >= "a" && c <= "z" || c >= "A" && c <= "Z" || c == "_"
}

// One token of TOKEN_RE, starting at `pos`: [kind, text, end], or nil when
// nothing matches. The branches are in the regex's alternation order.
fn scan_token(src, n, pos) {
    let c = src[pos]
    if (c == " " || c == "\t") {
        return ["WS", nil, str_span(src, pos + 1i, " \t")]
    }
    if (c == "#" || c == "/" && char_at(src, pos + 1i, n) == "/") {
        let j = str_span_until(src, pos, "\n")
        return ["COMMENT", substring(src, pos, j), j]
    }
    if (c == "\n") {
        return ["NL", nil, str_span(src, pos + 1i, "\n")]
    }
    if (is_digit(c)) {
        // Each run is found with one str_span and cut out with one substring,
        // rather than a call per character.
        let j = str_span(src, pos, DIGITS)
        let d = char_at(src, j, n)
        if (d == "I") {
            return ["NUM_INT_BAD", substring(src, pos, j + 1i), j + 1i]
        }
        if (d == "i") {
            if (is_ident_start(char_at(src, j + 1i, n))) {
                let k = str_span(src, j + 1i, IDENT_CHARS)
                return ["NUM_INT_DOUBLE", substring(src, pos, k), k]
            }
            return ["NUM_INT", substring(src, pos, j), j + 1i]
        }
        if (d == "." && is_digit(char_at(src, j + 1i, n))) {
            j = str_span(src, j + 1i, DIGITS)
        }
        let e = char_at(src, j, n)
        if (e == "e" || e == "E") {
            let k = j + 1i
            let sign = char_at(src, k, n)
            if (sign == "+" || sign == "-") {
                k = k + 1i
            }
            if (is_digit(char_at(src, k, n))) {
                j = str_span(src, k, DIGITS)
            }
        }
        return ["NUM", substring(src, pos, j), j]
    }
    if (is_ident_start(c)) {
        let j = str_span(src, pos + 1i, IDENT_CHARS)
        return ["ID", substring(src, pos, j), j]
    }
    let two = c + char_at(src, pos + 1i, n)
    if (has_key(TWO_CHAR_OPS, two)) {
        return ["OP", two, pos + 2i]
    }
    if (has_key(ONE_CHAR_OPS, c)) {
        return ["OP", c, pos + 1i]
    }
    return nil
}

fn reject_bad_int(kind, text, line, col) {
    if (kind == "NUM_INT_BAD") {
        let digits = ""
        let k = 0i
        while (k < len(text) - 1i) {
            digits = digits + text[k]
            k = k + 1i
        }
        fail("Integer suffix must be lowercase 'i', not 'I': use \(digits)i instead of \(text)", line, col)
    }
    let digits = ""
    let k = 0i
    while (is_digit(char_at(text, k, len(text)))) {
        digits = digits + text[k]
        k = k + 1i
    }
    fail("Invalid integer literal '\(text)': did you mean \(digits)i?", line, col)
}

fn hex_value(digits, line, col, label) {
    let v = 0i
    let k = 0i
    while (k < len(digits)) {
        let c = digits[k]
        let h = -1i
        if (is_digit(c)) {
            h = ord(c) - 48i
        } else if (c >= "a" && c <= "f") {
            h = ord(c) - 87i
        } else if (c >= "A" && c <= "F") {
            h = ord(c) - 55i
        }
        if (h < 0i) {
            fail("Invalid \(label) escape: \(digits)", line, col)
        }
        v = v * 16i + h
        k = k + 1i
    }
    return v
}

// `count` characters from `pos`, or fewer at the end of the source.
fn take(src, n, pos, count) {
    let end = pos + count
    if (end > n) {
        end = n
    }
    return substring(src, pos, end)
}

// A string literal starting at src[pos], which is `"`. Pushes its tokens onto
// `out` and returns [pos, line, col] after it. A plain string is one STR token;
// an interpolated one is STRING_START, its parts, then STRING_END.
fn lex_string(src, n, pos, start_line, start_col, depth, out) {
    if (depth > MAX_INTERP_DEPTH) {
        fail("Nesting depth exceeded (\(MAX_INTERP_DEPTH))", start_line, start_col)
    }
    let line = start_line
    let col = start_col + 1i
    pos = pos + 1i
    let buf = ""
    let parts = []
    let interpolated = false
    while (pos < n) {
        let ch = src[pos]
        if (ch != "\"" && ch != "\\" && ch != "\n") {
            // A run of plain text, taken whole.
            let stop = str_span_until(src, pos, STRING_STOPS)
            buf = buf + substring(src, pos, stop)
            col = col + (stop - pos)
            pos = stop
            continue
        }
        if (ch == "\"") {
            pos = pos + 1i
            col = col + 1i
            if (!interpolated) {
                push(out, tok("STR", buf, start_line, start_col))
                return [pos, line, col]
            }
            if (buf != "") {
                push(parts, tok("STRING_LITERAL", buf, line, col))
            }
            push(out, tok("STRING_START", "\"", start_line, start_col))
            for part in parts {
                push(out, part)
            }
            push(out, tok("STRING_END", "\"", line, col))
            return [pos, line, col]
        }
        if (ch == "\\" && pos + 1i < n) {
            let next = src[pos + 1i]
            if (next == "(") {
                interpolated = true
                if (buf != "") {
                    push(parts, tok("STRING_LITERAL", buf, line, col))
                    buf = ""
                }
                push(parts, tok("INTERP_START", "\\(", line, col))
                let r = lex_interp(src, n, pos + 2i, line, col + 2i, line, col, depth, parts)
                pos = r[0]
                line = r[1]
                col = r[2]
                continue
            }
            if (has_key(SIMPLE_ESCAPES, next)) {
                buf = buf + SIMPLE_ESCAPES[next]
                pos = pos + 2i
                col = col + 2i
                continue
            }
            if (next == "x") {
                let digits = take(src, n, pos + 2i, 2i)
                if (len(digits) < 2i) {
                    fail("Incomplete \\x escape: expected 2 hex digits", line, col)
                }
                buf = buf + chr(hex_value(digits, line, col, "\\x"))
                pos = pos + 4i
                col = col + 4i
                continue
            }
            if (next == "u") {
                let digits = take(src, n, pos + 2i, 4i)
                if (len(digits) < 4i) {
                    fail("Incomplete \\u escape: expected 4 hex digits", line, col)
                }
                buf = buf + chr(hex_value(digits, line, col, "\\u"))
                pos = pos + 6i
                col = col + 6i
                continue
            }
            fail("Unsupported escape sequence: \\\(next)", line, col)
        }
        if (ch == "\n") {
            fail("Unterminated string literal", start_line, start_col)
        }
        buf = buf + ch
        pos = pos + 1i
        col = col + 1i
    }
    fail("Unterminated string literal", start_line, start_col)
}

// The expression inside `\( ... )`, up to the `)` that closes it. Pushes onto
// `out`, ending with INTERP_END, and returns [pos, line, col] after it.
fn lex_interp(src, n, pos, line, col, interp_line, interp_col, depth, out) {
    let parens = 0i
    while (pos < n) {
        let ch = src[pos]
        if (ch == "\"") {
            let r = lex_string(src, n, pos, line, col, depth + 1i, out)
            pos = r[0]
            line = r[1]
            col = r[2]
            continue
        }
        if (ch == ")") {
            if (parens == 0i) {
                push(out, tok("INTERP_END", ")", line, col))
                return [pos + 1i, line, col + 1i]
            }
            parens = parens - 1i
            push(out, tok(")", ")", line, col))
            pos = pos + 1i
            col = col + 1i
            continue
        }
        if (ch == "(") {
            parens = parens + 1i
            push(out, tok("(", "(", line, col))
            pos = pos + 1i
            col = col + 1i
            continue
        }
        if (ch == ":" && parens == 0i) {
            fail("Format specifiers are reserved for a future version; remove ':' from the top-level interpolation expression", line, col)
        }
        if (ch == " " || ch == "\t") {
            pos = pos + 1i
            col = col + 1i
            continue
        }
        if (ch == "\n") {
            push(out, tok("SEP", "\n", line, col))
            line = line + 1i
            col = 1i
            pos = pos + 1i
            continue
        }
        let m = scan_token(src, n, pos)
        if (m == nil) {
            fail("Unexpected character '\(ch)' in interpolation", line, col)
        }
        let kind = m[0]
        let text = m[1]
        let end = m[2]
        if (kind == "NUM_INT_BAD" || kind == "NUM_INT_DOUBLE") {
            reject_bad_int(kind, text, line, col)
        }
        if (kind == "COMMENT" || kind == "NUM_INT" || kind == "NUM") {
            push(out, tok(kind, text, line, col))
        } else if (kind == "ID") {
            if (has_key(KEYWORDS, text)) {
                push(out, tok(KEYWORDS[text], text, line, col))
            } else {
                push(out, tok("ID", text, line, col))
            }
        } else if (kind == "OP") {
            if (text == ";") {
                push(out, tok("SEP", text, line, col))
            } else {
                push(out, tok(text, text, line, col))
            }
        }
        col = col + (end - pos)
        pos = end
    }
    fail("Unclosed interpolation expression", interp_line, interp_col)
}

// The loop below declares its own `text`, which used to make this parameter
// read as nil (#949). The self-host test fails if that comes back.
export fn tokenize(text) {
    let src = str_replace(str_replace(text, "\r\n", "\n"), "\r", "\n")
    let n = len(src)
    let pos = 0i
    if (n > 0i && src[0i] == "\uFEFF") {
        pos = 1i
    }
    let line = 1i
    let col = 1i
    let out = []
    // Inside an unclosed ( or [, a newline is whitespace, not a separator.
    let open_depth = 0i
    while (pos < n) {
        if (src[pos] == "\"") {
            let r = lex_string(src, n, pos, line, col, 0i, out)
            pos = r[0]
            line = r[1]
            col = r[2]
            continue
        }
        let m = scan_token(src, n, pos)
        if (m == nil) {
            fail("Unexpected character '\(src[pos])'", line, col)
        }
        let kind = m[0]
        let text = m[1]
        let end = m[2]
        if (kind == "WS") {
            col = col + (end - pos)
        } else if (kind == "NL") {
            if (open_depth == 0i) {
                push(out, tok("SEP", "\n", line, col))
            }
            line = line + (end - pos)
            col = 1i
        } else if (kind == "ID") {
            if (has_key(KEYWORDS, text)) {
                push(out, tok(KEYWORDS[text], text, line, col))
            } else {
                push(out, tok("ID", text, line, col))
            }
            col = col + (end - pos)
        } else if (kind == "OP") {
            if (text == ";") {
                push(out, tok("SEP", text, line, col))
            } else {
                push(out, tok(text, text, line, col))
                if (text == "(" || text == "[") {
                    open_depth = open_depth + 1i
                } else if ((text == ")" || text == "]") && open_depth > 0i) {
                    open_depth = open_depth - 1i
                }
            }
            col = col + (end - pos)
        } else if (kind == "COMMENT" || kind == "NUM_INT" || kind == "NUM") {
            push(out, tok(kind, text, line, col))
            col = col + (end - pos)
        } else {
            reject_bad_int(kind, text, line, col)
        }
        pos = end
    }
    push(out, tok("EOF", "", line, col))
    return out
}
